# Pooled connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection used only by Prisma CLI and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Public values used by Supabase Auth in the browser and on the server.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Canonical public origin used to construct trusted authentication callbacks.
APP_URL="http://localhost:3000"
