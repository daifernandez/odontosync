generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgendaView {
  DAY   @map("day")
  WEEK  @map("week")
  MONTH @map("month")

  @@map("agenda_view")
}

enum ExceptionalBlockCategory {
  VACATION @map("vacation")
  HOLIDAY  @map("holiday")
  PERSONAL @map("personal")
  OTHER    @map("other")

  @@map("exceptional_block_category")
}

enum AppointmentStatus {
  PENDING_CONFIRMATION @map("pending_confirmation")
  CONFIRMED            @map("confirmed")
  COMPLETED            @map("completed")
  CANCELLED            @map("cancelled")
  NO_SHOW              @map("no_show")
  RESCHEDULED          @map("rescheduled")

  @@map("appointment_status")
}

enum AppointmentSpecialty {
  GENERAL               @map("general")
  PEDIATRIC_DENTISTRY   @map("pediatric_dentistry")
  ORTHODONTICS          @map("orthodontics")
  SURGERY                @map("surgery")
  IMPLANTOLOGY           @map("implantology")
  ENDODONTICS            @map("endodontics")
  PERIODONTICS           @map("periodontics")
  RESTORATIVE            @map("restorative")
  PROSTHODONTICS         @map("prosthodontics")
  CONTROL                @map("control")
  AESTHETIC              @map("aesthetic")
  WHITENING              @map("whitening")

  @@map("appointment_specialty")
}

model Profile {
  id                  String          @id @db.Uuid
  fullName            String          @map("full_name")
  licenseNumber       String?         @map("license_number")
  licenseJurisdiction String?         @map("license_jurisdiction")
  agendaSettings      AgendaSettings?
  patients            Patient[]
  appointments        Appointment[]
  exceptionalAvailabilityBlocks ExceptionalAvailabilityBlock[]

  @@map("profiles")
}

model Patient {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?
  email     String?
  isActive  Boolean @default(true) @map("is_active")
  profile   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([userId, isActive, lastName, firstName])
  @@unique([id, userId], map: "patients_id_user_id_key")
  @@map("patients")
}

model Appointment {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  patientId        String                 @map("patient_id") @db.Uuid
  startsAt         DateTime               @map("starts_at") @db.Timestamptz(0)
  occupiedUntil    DateTime               @map("occupied_until") @db.Timestamptz(0)
  durationMinutes  Int                    @map("duration_minutes") @db.SmallInt
  cleanupMinutes   Int                    @map("cleanup_minutes") @db.SmallInt
  status           AppointmentStatus      @default(PENDING_CONFIRMATION)
  specialty        AppointmentSpecialty
  overlapConfirmed Boolean                @default(false) @map("overlap_confirmed")
  rescheduledFromId String?                @unique(map: "appointments_rescheduled_from_id_key") @map("rescheduled_from_id") @db.Uuid
  profile          Profile                @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient          Patient                @relation(fields: [patientId, userId], references: [id, userId], onDelete: Restrict)
  rescheduledFrom  Appointment?            @relation("AppointmentRescheduling", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo    Appointment?            @relation("AppointmentRescheduling")

  @@index([userId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

model ExceptionalAvailabilityBlock {
  id       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String                   @map("user_id") @db.Uuid
  startsAt DateTime                 @map("starts_at") @db.Timestamptz(0)
  endsAt   DateTime                 @map("ends_at") @db.Timestamptz(0)
  category ExceptionalBlockCategory
  profile  Profile                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@map("exceptional_availability_blocks")
}

model AgendaSettings {
  userId                            String                    @id @map("user_id") @db.Uuid
  gridIntervalMinutes               Int                       @default(15) @map("grid_interval_minutes") @db.SmallInt
  defaultAppointmentDurationMinutes Int                       @default(30) @map("default_appointment_duration_minutes") @db.SmallInt
  defaultCleanupMinutes             Int                       @default(5) @map("default_cleanup_minutes") @db.SmallInt
  lastAgendaView                    AgendaView                @default(WEEK) @map("last_agenda_view")
  profile                           Profile                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyAvailabilityBlocks          WeeklyAvailabilityBlock[]

  @@map("agenda_settings")
}

model WeeklyAvailabilityBlock {
  userId         String         @map("user_id") @db.Uuid
  dayOfWeek      Int            @map("day_of_week") @db.SmallInt
  startTime      DateTime       @map("start_time") @db.Time(0)
  endTime        DateTime       @map("end_time") @db.Time(0)
  agendaSettings AgendaSettings @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, dayOfWeek, startTime])
  @@map("weekly_availability_blocks")
}
